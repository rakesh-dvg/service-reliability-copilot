# Copy to .env for local Docker Compose. Never commit .env.

ENVIRONMENT=local
DEMO_MODE=true

# Shared tokens (dev defaults — change before any shared/public deployment)
ADMIN_API_TOKEN=dev-admin-token-change-me
RECOVERY_API_TOKEN=dev-recovery-token-change-me
ALERT_WEBHOOK_TOKEN=dev-alert-webhook-token-change-me

# Database (Compose overrides host to postgres service)
DATABASE_URL=postgresql+psycopg://src_user:src_pass@postgres:5432/src_db

# Observability
ENABLE_OTEL=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=src-backend
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:3000,http://localhost:8088

# Responder
BACKEND_BASE_URL=http://backend:8000
REMEDIATION_COOLDOWN_SECONDS=120
MAX_REMEDIATION_ATTEMPTS=2

# Optional Groq narrative (not required for recovery demo)
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Frontend build-time (also passed as Compose build args)
VITE_API_BASE_URL=
VITE_GRAFANA_URL=http://localhost:3000
VITE_ADMIN_API_TOKEN=dev-admin-token-change-me
VITE_DEMO_MODE=true
